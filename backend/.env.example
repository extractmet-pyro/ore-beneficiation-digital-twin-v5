# ---- application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
MODEL_VERSION=OBDT-2026.10.5
DEMO_MODE=true
# Comma-separated list of operator-desk origins (no trailing slash).
# On Render set this to the desk URL, e.g. https://obdt-v5-web.onrender.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_ORIGIN_REGEX=https://.*\.onrender\.com
# Optional shared secret. When set, every /api/v1 call needs header X-API-Key.
API_KEY=

# ---- start-up warm-up --------------------------------------------------------
# The hybrid and validation layers train models on first use. Left lazy, the first operator to
# open those pages waits for the whole build (about 25 s and 37 s on a full core, minutes on a
# fractional-CPU host). Warming them in a background thread at start-up moves that cost into the
# deploy, where nobody is watching. /health answers within ~25 ms regardless.
WARM_ON_START=true
WARM_HYBRID=true
# Design-of-experiments rows behind the hybrid models; each row is one twin solve.
# 320 is the shipped default. Drop to 140 on a free/fractional-CPU host to halve warm-up.
HYBRID_SAMPLES=320

# ---- engine ------------------------------------------------------------------
OPTIMIZER_MAX_EVALS=260
MONTE_CARLO_SAMPLES=14
SIM_CACHE_SIZE=1500
REPLAY_ANCHOR_UTC=2026-01-05T00:00:00Z

# ---- historian / DCS integration (placeholders) -------------------------------
# mock | opcua | pi | mqtt | kafka | csv | sql | rest
HISTORIAN_TYPE=mock
OPCUA_ENDPOINT=
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_NAMESPACE=ns=2;s=
PI_WEB_API_URL=
PI_DATA_SERVER=
PI_USERNAME=
PI_PASSWORD=
MQTT_BROKER_URL=
MQTT_TOPIC_PREFIX=plant/tags/
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=plant-tags
SQL_DATABASE_URL=
SQL_TABLE=historian
REST_HISTORIAN_URL=
REST_HISTORIAN_TOKEN=
CSV_HISTORIAN_PATH=
