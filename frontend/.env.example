# Used by scripts/write-config.mjs to generate config.js (Render static-site build, Docker start, local).
BACKEND_BASE_URL=http://localhost:8000
APP_ENV=development
# auto = live backend with automatic mock fallback | true = always mock | false = live only
MOCK_MODE=auto
# Must match backend API_KEY if set. NOTE: a static site exposes it to every browser user.
API_KEY=
# none | password  (APP_PASSWORD is hashed with SHA-256 into config.js — a light gate, not real security)
AUTH_MODE=none
APP_PASSWORD=
REQUEST_TIMEOUT_S=45
LONG_TIMEOUT_S=240
DEFAULT_PLANT=IX-CU-01
APP_TITLE=Industry-X Mining Digital Twin
